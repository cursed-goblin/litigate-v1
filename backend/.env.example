LLM_PROVIDER=groq

GROQ_API_KEY=
GEMINI_API_KEY=

# Leave the model settings unset to use the current defaults in config.py.
# Groq retires model ids periodically, so the client walks the fallback list
# below whenever the preferred id is rejected.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_MODEL_FALLBACKS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.0-flash

CORS_ORIGINS=http://localhost:3000,https://litigate.zenvx.in

CACHE_DIR=/tmp/litigate-cache
USE_CACHE=true
